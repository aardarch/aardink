{
  "defaultToken": "",
  "tokenPostfix": ".xml",
  "comments": {
    "blockComment": [
      "<!--",
      "-->"
    ]
  },
  "aardflexElements": [
    "wallpaper",
    "widget",
    "component",
    "theme",
    "include",
    "themes",
    "typography",
    "radius",
    "elevation",
    "spacing",
    "border",
    "opacity",
    "colors",
    "color",
    "variables",
    "var",
    "fonts",
    "font",
    "modules",
    "module",
    "background",
    "page",
    "layer",
    "column",
    "row",
    "box",
    "text",
    "time",
    "icon",
    "image",
    "emoji",
    "spacer",
    "shape",
    "progressbar",
    "circularprogress",
    "arc",
    "path",
    "polar",
    "skyplot",
    "orbitdisc",
    "effect",
    "divider",
    "button",
    "tap",
    "conditional"
  ],
  "tokenizer": {
    "root": [
      [
        "<!\\[CDATA\\[",
        "delimiter.cdata",
        "@cdata"
      ],
      [
        "<!--",
        "comment",
        "@comment"
      ],
      [
        "(<\\?)(xml)",
        [
          {
            "token": "delimiter"
          },
          {
            "token": "metatag",
            "next": "@metatag"
          }
        ]
      ],
      [
        "(<\\/?)(\\w+)",
        [
          {
            "token": "delimiter"
          },
          {
            "cases": {
              "@aardflexElements": {
                "token": "tag.aardflex",
                "next": "@tag"
              },
              "@default": {
                "token": "tag",
                "next": "@tag"
              }
            }
          }
        ]
      ],
      [
        "\\/>",
        "delimiter"
      ],
      [
        ">",
        "delimiter"
      ],
      [
        "\\{[^}\\n]{1,500}\\}",
        {
          "token": "@rematch",
          "next": "@expressionBody",
          "nextEmbedded": "aardflex-expression"
        }
      ],
      [
        "\\{",
        ""
      ],
      [
        "@[a-zA-Z][a-zA-Z0-9_]*",
        "variable.colorref"
      ],
      [
        "[^<{@]+",
        ""
      ],
      [
        "@",
        ""
      ]
    ],
    "tag": [
      [
        "\\s+",
        ""
      ],
      [
        "(\\w[\\w.:-]*)(\\s*)(=)(\\s*)",
        [
          "attribute.name",
          "",
          "delimiter",
          ""
        ]
      ],
      [
        "\"",
        "attribute.value",
        "@attrValueDouble"
      ],
      [
        "'",
        "attribute.value",
        "@attrValueSingle"
      ],
      [
        "\\/?>",
        "delimiter",
        "@pop"
      ],
      [
        "\\w[\\w.:-]*",
        "attribute.name"
      ],
      [
        ".",
        ""
      ]
    ],
    "attrValueDouble": [
      [
        "\\{[^}\"\\n]{1,500}\\}",
        {
          "token": "@rematch",
          "next": "@expressionBody",
          "nextEmbedded": "aardflex-expression"
        }
      ],
      [
        "@[a-zA-Z][a-zA-Z0-9_]*",
        "variable.colorref"
      ],
      [
        "[^\"{@]+",
        "attribute.value"
      ],
      [
        "[{@]",
        "attribute.value"
      ],
      [
        "\"",
        "attribute.value",
        "@pop"
      ]
    ],
    "attrValueSingle": [
      [
        "\\{[^}'\\n]{1,500}\\}",
        {
          "token": "@rematch",
          "next": "@expressionBody",
          "nextEmbedded": "aardflex-expression"
        }
      ],
      [
        "@[a-zA-Z][a-zA-Z0-9_]*",
        "variable.colorref"
      ],
      [
        "[^'{@]+",
        "attribute.value"
      ],
      [
        "[{@]",
        "attribute.value"
      ],
      [
        "'",
        "attribute.value",
        "@pop"
      ]
    ],
    "comment": [
      [
        "-->",
        "comment",
        "@pop"
      ],
      [
        ".",
        "comment"
      ]
    ],
    "cdata": [
      [
        "[^\\]]+",
        ""
      ],
      [
        "\\]\\]>",
        "delimiter.cdata",
        "@pop"
      ],
      [
        "\\]",
        ""
      ]
    ],
    "metatag": [
      [
        "\\?>",
        "delimiter",
        "@pop"
      ],
      [
        "\"[^\"]*\"",
        "string"
      ],
      [
        "\\w+",
        "metatag"
      ],
      [
        "=",
        "delimiter"
      ]
    ],
    "expressionBody": [
      [
        "\\}",
        {
          "token": "delimiter.expression",
          "next": "@pop",
          "nextEmbedded": "@pop"
        }
      ]
    ]
  }
}
